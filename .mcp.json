{
  "mcpServers": {
    "chromedevtools/chrome-devtools-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "env": {}
    },
    "electric-cherry": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "electric-cherry"
      ],
      "env": {}
    },
    "cherry-chrome-mcp": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "dlx",
        "github:brandon-fryslie/cherry-chrome-mcp"
      ],
      "env": {}
    }
  }
}