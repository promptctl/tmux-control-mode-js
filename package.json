{
  "name": "@promptctl/tmux-control-mode-js",
  "version": "0.3.0",
  "description": "Node.js client for tmux control mode protocol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promptctl/tmux-control-mode-js.git"
  },
  "homepage": "https://github.com/promptctl/tmux-control-mode-js#readme",
  "bugs": {
    "url": "https://github.com/promptctl/tmux-control-mode-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./keymap": {
      "types": "./dist/keymap/index.d.ts",
      "default": "./dist/keymap/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./chaos": {
      "types": "./dist/chaos/index.d.ts",
      "default": "./dist/chaos/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./electron/main": {
      "types": "./dist/connectors/electron/main.d.ts",
      "default": "./dist/connectors/electron/main.js"
    },
    "./electron/renderer": {
      "types": "./dist/connectors/electron/renderer.d.ts",
      "default": "./dist/connectors/electron/renderer.js"
    },
    "./websocket": {
      "types": "./dist/connectors/websocket/index.d.ts",
      "default": "./dist/connectors/websocket/index.js"
    },
    "./websocket/server": {
      "types": "./dist/connectors/websocket/server.d.ts",
      "default": "./dist/connectors/websocket/server.js"
    },
    "./websocket/client": {
      "types": "./dist/connectors/websocket/client.d.ts",
      "default": "./dist/connectors/websocket/client.js"
    },
    "./websocket/protocol": {
      "types": "./dist/connectors/websocket/protocol.d.ts",
      "default": "./dist/connectors/websocket/protocol.js"
    },
    "./websocket/transport": {
      "types": "./dist/connectors/websocket/transport.d.ts",
      "default": "./dist/connectors/websocket/transport.js"
    },
    "./streams/web": {
      "types": "./dist/connectors/streams/web.d.ts",
      "default": "./dist/connectors/streams/web.js"
    },
    "./streams/node": {
      "types": "./dist/connectors/streams/node.d.ts",
      "default": "./dist/connectors/streams/node.js"
    },
    "./window-terminal": {
      "types": "./dist/window-terminal/index.d.ts",
      "default": "./dist/window-terminal/index.js"
    },
    "./window-terminal/react": {
      "types": "./dist/window-terminal/react/index.d.ts",
      "default": "./dist/window-terminal/react/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@xterm/xterm": "^5.5.0",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@xterm/xterm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TMUX_INTEGRATION=1 vitest run tests/integration/ examples/web-multiplexer/web/",
    "test:all": "TMUX_INTEGRATION=1 vitest run",
    "bench:gate": "NODE_OPTIONS=\"--expose-gc\" vitest run --config vitest.bench.config.ts",
    "test:e2e": "pnpm --filter tmux-control-mode-js-demo-web-multiplexer run build:electron && playwright test --config tests/e2e/playwright.config.ts",
    "demo": "pnpm --filter tmux-control-mode-js-demo-web-multiplexer run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build && pnpm run check:browser-types && pnpm run typecheck:tests && tsc --noEmit -p tsconfig.e2e.json && pnpm -F tmux-control-mode-js-demo-web-multiplexer run typecheck",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:deps": "node scripts/check-no-deps.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:browser-types": "node scripts/check-browser-types.mjs",
    "prepublishOnly": "pnpm run check:deps && pnpm run clean && pnpm run build && pnpm run check:exports && pnpm run check:browser-types"
  },
  "keywords": [
    "tmux",
    "control-mode",
    "terminal"
  ],
  "author": {
    "name": "Brandon Fryslie",
    "email": "530235+brandon-fryslie@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/estree": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^20.9.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0",
    "ws": "^8.18.0"
  }
}
