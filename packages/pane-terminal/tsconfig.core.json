{
  "extends": "../../tsconfig.base.json",
  // [LAW:one-way-deps] [LAW:locality-or-seam] core (./stream, ./sink, ./bench)
  // is environment-agnostic — no DOM globals, no JSX. Splitting the config
  // makes that constraint mechanical: a stray `document.querySelector` in
  // src/stream would fail to compile here, instead of silently picking up
  // DOM types from a package-wide lib setting.
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022"],
    "types": []
  },
  "references": [
    { "path": "../../src" }
  ],
  "include": [
    "src/stream/**/*.ts",
    "src/sink/**/*.ts",
    "src/bench/**/*.ts"
  ]
}
